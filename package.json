    "mongoose": "^7.0.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.1"
  },
  "keywords": [
    "laboratory",
    "lims",
    "complaints",
    "management"
  ],
