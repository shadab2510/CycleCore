{
  "name": "cyclecore-lims",
  "version": "1.0.0",
  "description": "Laboratory Information and Complaint Management System",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
